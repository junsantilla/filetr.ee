# Copy this file to .env.local and fill in the values you need.
#
# Only MONGODB_URI and the AUTH_* variables are needed to run the site
# locally with sign-in working. Everything else is optional.

# MongoDB connection string. lib/mongodb.ts throws on startup without it.
MONGODB_URI=mongodb://localhost:27017/filetree

# GitHub OAuth app used by NextAuth for sign-in (auth.ts).
# Create one at https://github.com/settings/developers with the callback URL
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Secret NextAuth uses to sign session tokens. Generate one with: npx auth secret
AUTH_SECRET=

# Separate GitHub OAuth app for the "connect repositories" flow
# (app/api/github/connect and app/api/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CONNECT_CALLBACK=http://localhost:3000/api/github/callback

# Hostname images are served from for the WordPress blog, e.g.
# filetreeblog.files.wordpress.com. Leave blank if you are not working on
# the blog; next.config.mjs skips the rule when it is unset.
WORDPRESS_IMAGE_HOST=

# Set to "production" by Vercel. Analytics only load when this is production,
# so leave it unset locally.
NEXT_PUBLIC_VERCEL_ENV=
